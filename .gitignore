# macOS
.DS_Store

# Xcode user-specific
**/xcuserdata/
*.xcuserstate
*.xcuserdatad

# Build artifacts
**/build/
**/DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# CocoaPods (사용 안 함이지만 안전 차원)
Pods/

# Carthage (사용 안 함)
Carthage/Build/

# Xcode debug / runtime
*.hmap
*.ipa
*.xcarchive

# 임시 / 시뮬 캡처 (필요한 것만 별도 커밋 권장)
# screenshot_*.png

# Misc
*.log

# Firebase client config — each contributor downloads their own plist from
# the Firebase console (see docs/SIGNING_AND_BACKEND.md). The plist holds
# the project's discoverable API key, which is OK to commit per Firebase
# guidance, but we keep it out so forks aren't pinned to one project.
StudyApp/GoogleService-Info.plist

# SwiftData backup archives created by AppModelContainer when a schema
# migration fails. Local-only, never relevant in source.
**/Documents/Backups/
